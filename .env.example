# Canonical origin for everything this app serves. NEVER derived from the request
# host or VERCEL_URL — previews must not canonicalise to themselves.
PUBLIC_BASE_URL=https://www.cosora.in

# Shared Cosora Supabase project. Anon key only: this app is read-only and the anon
# role has no write grant on the blog tables.
NEXT_PUBLIC_SUPABASE_URL=https://vxdhhgdfubqedfpwfyrb.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Shared secret for POST /blogs/api/revalidate, sent by the Supabase webhook as the
# x-revalidate-secret header. Generate with: openssl rand -hex 32
REVALIDATE_SECRET=
